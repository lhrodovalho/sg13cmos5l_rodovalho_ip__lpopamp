set xlabel 'Frequency (Hz)'
set ylabel 'Phase (°)'
set logscale x
set format x "10^{%L}"
set grid
set key off
set term png
set output 'ph.png'
set datafile separator ','
plot \
'../data/tb_lpopamp_open_ac_sch_ph.csv0' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv1' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv2' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv3' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv4' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv5' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv6' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv7' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_ph.csv8' with lines lt rgb 'blue',\
