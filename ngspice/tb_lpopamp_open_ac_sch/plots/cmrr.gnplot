set xlabel 'Frequency (Hz)'
set ylabel 'CMRR (dB)'
set logscale x
set format x "10^{%L}"
set grid
set key off
set term png
set output 'cmrr.png'
set datafile separator ','
plot \
'../data/tb_lpopamp_open_ac_sch_cmrr.csv0' with lines lt rgb 'blue',\
