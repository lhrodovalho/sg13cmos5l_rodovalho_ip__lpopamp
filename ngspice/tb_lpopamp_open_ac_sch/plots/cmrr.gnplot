'../data/tb_lpopamp_open_ac_sch_cmrr.csv2' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_cmrr.csv3' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_cmrr.csv4' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_cmrr.csv5' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_cmrr.csv6' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_cmrr.csv7' with lines lt rgb 'blue',\
'../data/tb_lpopamp_open_ac_sch_cmrr.csv8' with lines lt rgb 'blue',\
