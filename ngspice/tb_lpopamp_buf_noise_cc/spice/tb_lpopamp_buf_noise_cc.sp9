* num: 9 corner: mos_ss vdd: 3.6 temp: -40

* Include models
.lib ../..//models/cornerMOShv.lib mos_ss
.temp -40

.include ../../netlists/lpopamp.cc.spice

* Simulation parameters
.param xavdd  = 3.6
.param xavss  = 0
.param xen    = 1
.param xvin   = {3.6/2}
.param xvout  = {3.6/2}

.param xavdd_ac = 0
.param xvin_ac  = 1
.param xvout_ac = 0

.param xibias = 7.75u

.param xcl    = 15p
.param xrl    = 1T

* Design under test
*.subckt lpopamp in_m in_p ib en avss avdd out
Xdut out ip ibias en avss avdd out lpopamp

v_avss GND avss xavss
v_avdd avdd avss dc {xavdd} ac {xavdd_ac} 
v_in in avss dc {xvin} ac {xvin_ac} 
v_en en avss {xen*xavdd} 
v_enb enb avss {(1-xen)*xavdd} 
i_ibias avdd ibias {xen*xibias} 
CL out avss 'xcl' m=1 

* Simulation control
.option rshunt = 1e12
.control
  pre_osdi ../../models/psp103_nqs.osdi

  noise v(out) v_in dec 10 1 1G
  let onoise_10k   = noise1.onoise_spectrum[40]
  let onoise_total = noise2.onoise_total
  print onoise_10k onoise_total

  plot noise1.onoise_spectrum loglog
  
  echo "num,corner,vdd,temp,onoise_10k,onoise_total"         >  ./meas/tb_lpopamp_buf_noise_cc.meas9
  echo "9,mos_ss,3.6,-40,$&onoise_10k,$&onoise_total" >> ./meas/tb_lpopamp_buf_noise_cc.meas9

  wrdata ./data/tb_lpopamp_buf_noise_cc_onoise.dat9 noise1.frequency noise1.onoise_spectrum

.endc

.GLOBAL GND 
.end 

