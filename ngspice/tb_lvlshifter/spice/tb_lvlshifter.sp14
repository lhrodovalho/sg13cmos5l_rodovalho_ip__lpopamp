* num: 14 corner: mos_ff vdd: 3.6 temp: 85

* Include models
.lib ../..//models/cornerMOShv.lib mos_ff
.temp 85

.include ../../netlists/lvlshifter.spice


* Simulation parameters
.param xavdd  = 3.6
.param xavss  = 0

.param xvhi  = {1.2}
.param xvlo  = {0}
.param xper  = {1u}
.param xtdel = {0}
.param xtr   = {xper/2}
.param xpw   = {1f}

* Design under test
*.subckt lvlshifter in out vdd vss
xdut in out avdd avss lvlshifter

v_avss GND avss xavss
v_avdd avdd avss dc {xavdd} 
v_in in avss pulse({xvlo} {xvhi} {xtdel} {xtr} {xtr} {xpw} {xper}) 

* Simulation control
.option gmin=1e-12
.option rshunt=1e12
.option method=Gear
.param xtstart = 0
.param xtend   = {xper}
.param xtstep  = {0.5e-9}
.tran {xtstep} {xtend} {xtstart}

.save v(in) v(out)
.control
  pre_osdi ../../models/psp103_nqs.osdi

  run
  plot in out

  let avdd = 3.3
  let vhi  = avdd-50m
  let vlo  = 50m
  let vmax = vlo+0.9*(vhi-vlo)
  let vmin = vlo+0.1*(vhi-vlo)
  let dv   = vmax-vmin

  wrdata ../data/tb_lvlshifter.dat14 v(in) v(out)

.endc

.GLOBAL GND 
.end 

